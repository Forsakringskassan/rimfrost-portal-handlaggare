# ─────────────────────────────────────────────────────────────────────────────
# Rimfrost Docker environment configuration
#
# Copy this file to .env.docker and fill in your internal URLs.
# Then run:  docker compose --env-file .env.docker up
#
# NOTE: BFF URLs (RUNTIME_*_BFF_URL) must be reachable from the end user's
# browser, not just from within the Docker network. If running behind a reverse
# proxy or ingress, use the external hostname/path here.
# ─────────────────────────────────────────────────────────────────────────────

# ── Portal frontend (RUNTIME_* injected into browser at startup) ───────────
# URL of the portal BFF as seen from the browser
RUNTIME_BFF_URL=https://portal-bff.internal.example.com

# remoteEntry.js URLs for the micro-frontends as seen from the browser
RUNTIME_REMOTE_APP_URL=https://rtf-manuell-fe.internal.example.com/assets/remoteEntry.js
RUNTIME_EXAMPLE_APP_URL=https://bekraftabeslut-fe.internal.example.com/assets/remoteEntry.js

# ── Portal BFF ────────────────────────────────────────────────────────────────
# Full URL to the handläggare list endpoint on the handläggning backend
HANDLAGGARE_URL=https://handlaggning.internal.example.com/handlaggare

# Base URL of the OUL service
BE_OUL_URL=https://oul.internal.example.com

# ── RTF Manuell ───────────────────────────────────────────────────────────────
# BFF URL for the RTF Manuell FE (as seen from the browser)
RUNTIME_RTF_MANUELL_BFF_URL=https://rtf-manuell-bff.internal.example.com

# Backend service URL for the RTF Manuell BFF
BE_RTF_MANUELL_URL=https://rtf-manuell-backend.internal.example.com

# Rule path (usually does not need to change)
BE_RTF_MANUELL_RULE_PATH=regel/rtf-manuell

# ── Bekräfta Beslut ───────────────────────────────────────────────────────────
# BFF URL for the Bekräfta Beslut FE (as seen from the browser)
RUNTIME_BEKRAFTABESLUT_BFF_URL=https://bekraftabeslut-bff.internal.example.com

# Backend service URL for the Bekräfta Beslut BFF
BE_BEKRAFTABESLUT_URL=https://bekraftabeslut-backend.internal.example.com
